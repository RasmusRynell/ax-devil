{
  "cases": [
    {
      "name": "one lane, exact frames, nearest first then behind",
      "playhead": 10,
      "direction": "forward",
      "first": 8,
      "maps": [[1, 2, 3, 4, 5]],
      "expected": [
        [3, 10],
        [4, 11],
        [5, 12],
        [2, 9],
        [1, 8]
      ]
    },
    {
      "name": "two lanes on one source select different samples at one frame: the lower index goes first",
      "playhead": 10,
      "direction": "forward",
      "first": 10,
      "maps": [
        [7, 4294967295],
        [3, 4294967295]
      ],
      "expected": [
        [3, 10],
        [7, 10]
      ]
    },
    {
      "name": "a sample mapped on both sides of the playhead ranks by its better frame",
      "playhead": 10,
      "direction": "forward",
      "first": 8,
      "maps": [[5, 5, 4294967295, 5, 6]],
      "expected": [
        [5, 11],
        [6, 12]
      ]
    },
    {
      "name": "backward travel prefers the frames behind",
      "playhead": 10,
      "direction": "backward",
      "first": 8,
      "maps": [[1, 2, 3, 4, 5]],
      "expected": [
        [3, 10],
        [2, 9],
        [1, 8],
        [4, 11],
        [5, 12]
      ]
    },
    {
      "name": "none and empty cells select nothing",
