{
  "schema": 4,
  "id": "built-in:standard",
  "name": "Standard",
  "description": "The everyday default: thin boxes in the class color, the id on a tab at the top and the score on a tab at the bottom.",
  "vars": {
    "color": "#828b96",
    "ink": "#ffffff",
    "id_inside": false,
    "line": "1.5px",
    "tint": 0,
    "font": "11px"
  },
  "rules": [
    { "when": "class != null", "set": { "color": "#27ae60" } },
    { "when": "class in ['vehicle', 'vehicle_other', 'car', 'bus', 'truck', 'bike', 'bicycle']", "set": { "color": "#2f80ed" } },
    { "when": "class == 'human'", "set": { "color": "#f2a100", "ink": "#111111" } },
    { "when": "class == 'head'", "set": { "color": "#9b51e0", "id_inside": true } }
  ],
  "layers": [
    { "feature": "outlines", "marks": [
      { "mark": "box", "stroke": "color", "width": "line", "dash": "attr.occluded", "fill": "alpha(color, tint)" },
      { "mark": "polygon", "stroke": "color", "width": "1px" }
    ] },
    { "feature": "relations", "for": "relations", "when": "relation == 'has_part'", "marks": [
      { "mark": "line", "from": "anchor(source.box, 'center')", "to": "anchor(target.box, 'center')", "stroke": "#eceff4", "width": "1.5px" },
      { "mark": "circle", "on": "source.box", "r": "3px", "stroke": "#0e1014", "width": "1px", "fill": "#eceff4" },
      { "mark": "circle", "on": "target.box", "r": "3px", "stroke": "#0e1014", "width": "1px", "fill": "#eceff4" }
    ] },
    { "feature": "speed", "marks": [
      { "mark": "arrow", "gain": 0.5, "max": "100px", "head": "6px", "head_width": "3.5px", "stroke": "color", "width": "1.5px" }
    ] },
    { "feature": "movement", "when": "motion_state != null", "marks": [
      { "mark": "label", "size": "font", "background": "color", "pad": ["3px", "1px"],
        "runs": [ { "text": "case(motion_state, 'moving', '▶', 'stationary', 'Ⅱ', '?')", "color": "ink", "weight": "medium" } ],
        "place": [ { "at": "top-right", "anchor": "top-left", "dx": "0.75px", "dy": "-0.75px" } ] }
    ] },
    { "feature": "ids", "marks": [
      { "mark": "label", "size": "font", "background": "color", "pad": ["4px", "1px"],
        "runs": [ { "text": "trim(id, 10, 'middle')", "color": "ink", "weight": "medium" } ],
        "place": [
          { "when": "!id_inside", "at": "top-left", "anchor": "bottom-left", "dx": "-0.75px", "dy": "0.75px" },
          { "at": "top-left", "anchor": "top-left", "dx": "-0.75px", "dy": "-0.75px" } ] }
    ] },
    { "feature": "score", "when": "score != null", "marks": [
      { "mark": "label", "size": "font", "background": "color", "pad": ["4px", "1px"],
        "runs": [ { "text": "fixed(score, 2)", "color": "ink", "weight": "medium" } ],
        "place": [
          { "at": "bottom-left", "anchor": "top-left", "dx": "-0.75px", "dy": "-0.75px" },
          { "at": "bottom-left", "anchor": "bottom-left", "dx": "-0.75px", "dy": "0.75px" } ] }
    ] },
    { "feature": "confidence", "when": "confidence != null", "marks": [
      { "mark": "label", "size": "font", "background": "color", "pad": ["4px", "1px"],
        "runs": [ { "text": "fixed(confidence, 2)", "color": "ink", "weight": "medium" } ],
        "place": [
          { "at": "bottom-right", "anchor": "top-right", "dx": "0.75px", "dy": "-0.75px" },
          { "at": "bottom-right", "anchor": "bottom-right", "dx": "0.75px", "dy": "0.75px" } ] }
    ] }
  ]
}
