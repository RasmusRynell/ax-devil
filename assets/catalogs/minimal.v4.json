{
  "schema": 4,
  "id": "built-in:minimal",
  "name": "Minimal",
  "description": "For crowds: thin boxes in the class color and nothing else. Hover an object for its details.",
  "vars": {
    "color": "#828b96",
    "ink": "#ffffff"
  },
  "rules": [
    { "when": "class != null", "set": { "color": "#27ae60" } },
    { "when": "class in ['vehicle', 'vehicle_other', 'car', 'bus', 'truck', 'bike', 'bicycle']", "set": { "color": "#2f80ed" } },
    { "when": "class == 'human'", "set": { "color": "#f2a100", "ink": "#111111" } },
    { "when": "class == 'head'", "set": { "color": "#9b51e0" } }
  ],
  "layers": [
    { "feature": "outlines", "marks": [
      { "mark": "box", "stroke": "color", "width": "1px", "dash": "attr.occluded", "fill": "alpha(color, 0)" },
      { "mark": "polygon", "stroke": "color", "width": "1px" }
    ] },
    { "feature": "relations", "for": "relations", "when": "relation == 'has_part'", "marks": [
      { "mark": "line", "from": "anchor(source.box, 'center')", "to": "anchor(target.box, 'center')", "stroke": "#eceff4", "width": "1px" },
      { "mark": "circle", "on": "source.box", "r": "2.5px", "stroke": "#0e1014", "width": "1px", "fill": "#eceff4" },
      { "mark": "circle", "on": "target.box", "r": "2.5px", "stroke": "#0e1014", "width": "1px", "fill": "#eceff4" }
    ] },
    { "feature": "speed", "marks": [
      { "mark": "arrow", "gain": 0.5, "max": "100px", "head": "6px", "head_width": "3.5px", "stroke": "color", "width": "1.5px" }
    ] },
    { "feature": "movement", "when": "motion_state != null", "marks": [
      { "mark": "label", "size": "10px", "background": "color", "pad": ["2px", "1px"],
        "runs": [ { "text": "case(motion_state, 'moving', '▶', 'stationary', 'Ⅱ', '?')", "color": "ink", "weight": "medium" } ],
        "place": [ { "at": "top-right", "anchor": "top-left", "dx": "0.5px", "dy": "-0.5px" } ] }
    ] }
  ]
}
